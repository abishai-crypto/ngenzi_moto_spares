# ==============================================================================
# NGENZI MOTO SPARE PARTS - ENVIRONMENT CONFIGURATION TEMPLATE
# Dar es Salaam, Tanzania
# Copy this file to .env and configure for your local/production environment
# ==============================================================================

# Application Details
APP_NAME="NGENZI MOTO SPARE PARTS"
APP_ENV=production
APP_DEBUG=false
APP_URL="http://localhost"
APP_TIMEZONE="Africa/Dar_es_Salaam"

# Database Configuration (MySQL / MariaDB)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="ngenzi_moto_spare"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# Paths & Security
STORAGE_PATH="storage"
BACKUP_PATH="storage/backups"
LOG_PATH="storage/logs"
MAX_LOG_SIZE_MB=5

# Currency & Localization
DEFAULT_CURRENCY="TZS"
CURRENCY_SYMBOL="TSh"
